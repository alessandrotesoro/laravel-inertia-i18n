{
	"name": "@sematico/laravel-inertia-i18n-react",
	"version": "0.1.0",
	"description": "React hooks and components for consuming Laravel JSON translations via Inertia.js",
	"type": "module",
	"main": "./packages/react/dist/index.cjs",
	"module": "./packages/react/dist/index.js",
	"types": "./packages/react/dist/index.d.ts",
	"exports": {
		".": {
			"import": {
				"types": "./packages/react/dist/index.d.ts",
				"default": "./packages/react/dist/index.js"
			},
			"require": {
				"types": "./packages/react/dist/index.d.cts",
				"default": "./packages/react/dist/index.cjs"
			}
		}
	},
	"files": [
		"packages/react/dist",
		"README.md",
		"LICENSE.md"
	],
	"scripts": {
		"build": "tsup --config packages/react/tsup.config.ts",
		"prepare": "tsup --config packages/react/tsup.config.ts",
		"release:verify": "pnpm check && pnpm typecheck && pnpm test:js && pnpm build",
		"test:js": "vitest run --config packages/react/vitest.config.ts",
		"test:php": "composer test",
		"typecheck": "tsc --project packages/react/tsconfig.json --noEmit",
		"lint": "biome check packages/react",
		"format": "biome format --write packages/react",
		"check": "biome check packages/react"
	},
	"peerDependencies": {
		"@inertiajs/react": "^3.0.0",
		"react": "^19.0.0"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.7",
		"@inertiajs/react": "^3.0.0",
		"@testing-library/react": "^16.0.0",
		"@types/html-parse-stringify": "^3.0.0",
		"@types/node": "^24.13.3",
		"@types/react": "^19.0.0",
		"jsdom": "^26.0.0",
		"react": "^19.0.0",
		"react-dom": "^19.0.0",
		"tsup": "^8.0.0",
		"typescript": "^5.7.0",
		"vitest": "^3.0.0"
	},
	"keywords": [
		"laravel",
		"inertia",
		"i18n",
		"react",
		"translations",
		"i18next"
	],
	"license": "MIT",
	"author": "Alessandro Tesoro",
	"dependencies": {
		"html-parse-stringify": "^3.0.1"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/alessandrotesoro/laravel-inertia-i18n.git"
	},
	"bugs": {
		"url": "https://github.com/alessandrotesoro/laravel-inertia-i18n/issues"
	},
	"homepage": "https://github.com/alessandrotesoro/laravel-inertia-i18n",
	"publishConfig": {
		"access": "public"
	}
}
